# Оставьте пустым для работы на статических данных (data.js)
# Заполните после настройки Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Telegram-бот для приёма заявок из ContactForm (site/api/contact.js)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Отдельный телеграм-бот для уведомлений о сбоях (site/api/_lib/alertBot.js)
TELEGRAM_ALERTS_BOT_TOKEN=your_alerts_bot_token_here
TELEGRAM_ALERTS_CHAT_ID=your_alerts_chat_id_here
